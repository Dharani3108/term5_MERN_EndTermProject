# Copy to .env and adjust. Never commit the real .env file.

# HTTP port the server listens on
PORT=3000

# "production" enables Secure cookies (requires HTTPS)
NODE_ENV=development

# SQLite database file location (directory is created automatically)
DB_PATH=./data/slotwise.db

# IANA timezone that opening hours and day boundaries are evaluated in
CAMPUS_TZ=Asia/Kolkata

# First admin account, created only when the database is empty
ADMIN_EMAIL=admin@slotwise.app
ADMIN_PASSWORD=change-me-Admin123

# Seed demo resources, students and booking history on an empty database
SEED_DEMO=true

# Show the demo account credentials on the login page (public demo deployments only)
PUBLIC_DEMO=false

# How often background jobs run, in milliseconds
JOB_INTERVAL_MS=60000
